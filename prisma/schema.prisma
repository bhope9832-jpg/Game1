// VidForge database schema
// Prisma + PostgreSQL. Works with Supabase, Neon, RDS, or any Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth & roles ----------

// Platform-level role. PLATFORM_ADMIN has unrestricted access to every user,
// team, and generation — enforced centrally in lib/rbac.ts.
enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  platformRole PlatformRole @default(USER)

  // Billing & credits (personal)
  credits            Int      @default(0) // paid / granted balance, never expires
  dailyCredits       Int      @default(0) // free daily allowance, refreshed lazily
  dailyCreditsResetAt DateTime @default(now())
  plan               Plan     @default(FREE)
  stripeCustomerId   String?  @unique
  stripeSubscriptionId String? @unique
  stripePriceId      String?
  planRenewsAt       DateTime?

  isBanned Boolean @default(false)

  accounts           Account[]
  sessions           Session[]
  generations        Generation[]
  creditTransactions CreditTransaction[]
  teamMemberships    TeamMembership[]
}

// ---------- Teams ----------

// Team-level role hierarchy: OWNER > ADMIN > MEMBER (see lib/rbac.ts).
enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model Team {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  credits   Int      @default(0) // shared credit pool, spent by team generations
  createdAt DateTime @default(now())

  memberships        TeamMembership[]
  invites            TeamInvite[]
  generations        Generation[]
  creditTransactions CreditTransaction[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// Pending invite for an email that may not have an account yet; claimed
// automatically on first sign-in (see lib/auth.ts createUser event).
model TeamInvite {
  id          String   @id @default(cuid())
  teamId      String
  email       String
  role        TeamRole @default(MEMBER)
  invitedById String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Generations ----------

enum GenerationStatus {
  PENDING // accepted, queued at the provider
  PROCESSING // provider is rendering
  COMPLETED
  FAILED
}

enum GenerationMode {
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
}

model Generation {
  id             String           @id @default(cuid())
  userId         String
  // When set, the generation ran in a team workspace: it spent the team's
  // credit pool and is visible to every member of that team.
  teamId         String?
  mode           GenerationMode
  model          String // model id from lib/models.ts, e.g. "seedance-2.0"
  falRequestId   String? // provider queue request id, used for polling
  prompt         String           @db.Text
  negativePrompt String?          @db.Text
  inputImageUrl  String? // for image-to-video
  outputVideoUrl String? // permanent URL (R2/S3) once re-hosted
  providerVideoUrl String? // temporary provider URL, kept for debugging
  status         GenerationStatus @default(PENDING)
  error          String?          @db.Text
  duration       Int // seconds
  aspectRatio    String // "16:9" | "9:16" | "1:1" | "4:3" | "21:9"
  resolution     String // "480p" | "720p"
  seed           Int?
  cameraMotion   String?
  creditsUsed    Int
  creditsRefunded Boolean         @default(false)
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([status])
}

// ---------- Credits & billing ----------

enum Plan {
  FREE
  STARTER
  PRO
  UNLIMITED
}

enum CreditTransactionType {
  DAILY_GRANT // free daily allowance refresh
  PLAN_GRANT // monthly credits from a subscription
  PACK_PURCHASE // one-time credit pack
  GENERATION // deducted when a generation is submitted
  REFUND // returned when a generation fails
  TEAM_TRANSFER // personal → team pool transfer
  ADMIN_ADJUSTMENT
}

model CreditTransaction {
  id        String                @id @default(cuid())
  // The acting user. For team transactions this is who triggered the spend;
  // teamId identifies whose pool the amount moved in/out of.
  userId    String
  teamId    String?
  type      CreditTransactionType
  amount    Int // positive = credit, negative = debit
  balanceAfter Int // balance of the affected wallet (user or team) after this tx
  generationId String?
  stripeEventId String? @unique // idempotency guard for webhook grants
  note      String?
  createdAt DateTime              @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
}
