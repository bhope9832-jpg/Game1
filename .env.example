# ---------- Database ----------
# PostgreSQL connection string (Supabase / Neon / RDS all work)
DATABASE_URL="postgresql://user:password@localhost:5432/vidforge"

# ---------- Auth (NextAuth.js v5) ----------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Canonical URL of the deployment (http://localhost:3000 in dev)
AUTH_URL="http://localhost:3000"
# Google OAuth — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Resend API key for email magic-link sign-in — https://resend.com
AUTH_RESEND_KEY=""
EMAIL_FROM="VidForge <login@yourdomain.com>"

# ---------- fal.ai (server-side only, never exposed to the client) ----------
FAL_KEY=""

# ---------- Stripe ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring subscription prices (create in the Stripe dashboard)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_UNLIMITED=""
# One-time credit pack prices
STRIPE_PRICE_PACK_SMALL=""
STRIPE_PRICE_PACK_LARGE=""

# ---------- Video storage (Cloudflare R2 via S3 API, or AWS S3) ----------
# Leave blank to fall back to (temporary!) fal URLs — fine for local dev only.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="vidforge-videos"
# Public base URL of the bucket (custom domain or r2.dev subdomain)
R2_PUBLIC_URL=""

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated emails that get access to /admin
ADMIN_EMAILS=""
